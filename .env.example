# Copy to .env.local when you choose a database. Leave these unset until then.
# Dev and production builds do not connect to a database.

# SQLite (local file):
# DATABASE_URL="file:./.data/app.db"
#
# PostgreSQL:
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/portfolio"
DATABASE_URL=

# sqlite or postgresql. Read by drizzle.config.ts when you generate migrations.
# Leave unset until you choose a database. See README.md.
DATABASE_DIALECT=
